NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
BACKEND_API_BASE_URL=http://localhost:8000
# Admin/service key the proxy at pages/api/backend/[...path] sends on writes and
# admin reads. Server-only: never prefix this with NEXT_PUBLIC_.
SERVICE_API_KEY=your_backend_service_api_key

# Read-only key the same proxy sends on public display reads
# (team, sponsors, events, certificate verify/download). Server-only.
PUBLIC_API_KEY=your_backend_public_api_key
NEXT_PUBLIC_ADMIN_USERNAME=admin
NEXT_PUBLIC_ADMIN_PASSWORD=admin
NEXT_PUBLIC_MANAGER_USERNAME=manager
NEXT_PUBLIC_MANAGER_PASSWORD=manager
